# Build context: the repository root (the jar packages data/kb, db/seed and eval/tickets.jsonl).
FROM docker.io/library/maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
COPY backend/pom.xml backend/
COPY backend/lib backend/lib
RUN mvn -B -q -pl backend dependency:go-offline || true
COPY backend/src backend/src
COPY data data
COPY db db
COPY eval/tickets.jsonl eval/
RUN mvn -B -q -pl backend package -DskipTests

FROM docker.io/library/eclipse-temurin:21-jre
WORKDIR /app
RUN useradd --system --uid 10001 app && mkdir -p /app/eval/reports && chown -R app /app
COPY --from=build /src/backend/target/backend-*.jar /app/app.jar
USER app
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
